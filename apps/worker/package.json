{
  "name": "@dnafix/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node init && tsx --env-file-if-exists=../../.env --watch src/index.ts",
    "start": "node init && tsx --env-file-if-exists=../../.env src/index.ts",
    "build": "node init && tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-iam": "^3.716.0",
    "@dnafix/application": "workspace:*",
    "@dnafix/remote-execution": "workspace:*",
    "@temporalio/client": "^1.11.6",
    "@temporalio/worker": "^1.11.6",
    "@temporalio/workflow": "^1.11.6"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
