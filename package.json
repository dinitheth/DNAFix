{
  "name": "dnafix",
  "version": "0.1.0",
  "private": true,
  "description": "Architecture-aware autonomous software engineer: Project DNA understanding + Muse Wonder planning + controlled execution + independent verification.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.23.2 <23",
    "pnpm": "9.15.4"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:unit": "vitest run packages tests/unit",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "dev": "pnpm --parallel --filter @dnafix/api --filter @dnafix/worker --filter @dnafix/web dev",
    "dev:api": "pnpm --filter @dnafix/api dev",
    "dev:web": "pnpm --filter @dnafix/web dev",
    "db:migrate": "node packages/persistence/migrations/apply.mjs",
    "model:smoke": "tsx packages/model-provider/scripts/smoke.ts",
    "demo:offline": "tsx scripts/demo-offline.mts",
    "remote:check": "tsx scripts/run-remote-check.mts",
    "fixture:seed": "tsx scripts/seed-fixture.mts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.0"
  }
}
