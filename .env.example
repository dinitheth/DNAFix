# DNAFix environment. Copy to .env and fill in. Never commit real secrets.

# App
NODE_ENV=development
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
DNAFIX_DATA_DIR=.data
# Optional bearer token for the API (single-user local auth). Empty = no auth (local only).
DNAFIX_SESSION_TOKEN=

# Persistence (local dev uses the JSON file store under DNAFIX_DATA_DIR; Postgres is for production)
DATABASE_URL=

# Muse Wonder (Meta Model API) — required for real planning/patching/verification review
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
MUSE_WONDER_MODEL=muse-wonder-1.0
# Sub-agent model (coding + verification). Lead planning stays on Muse Wonder.
MUSE_SPARK_MODEL=muse-spark-1.3
MODEL_TRANSPORT=responses
MUSE_REASONING_EFFORT=

# Project DNA (deterministic repository intelligence). Path to a Project DNA checkout
# with `pnpm install` completed under Node 22.23.2.
PROJECT_DNA_PATH=
PROJECT_DNA_TIMEOUT_MS=600000

# GitHub App (required only for draft PR creation)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_BASE_URL=https://api.github.com

# Workflow
WORKFLOW_ENGINE=in-process
TEMPORAL_ADDRESS=
TEMPORAL_TASK_QUEUE=dnafix

# Execution sandbox: docker (default, fails closed when unavailable) | host (dev only, reduced isolation)
SANDBOX_MODE=docker
SANDBOX_IMAGE=node:22-alpine
SANDBOX_MEMORY=1g
SANDBOX_CPUS=1

# Agent limits
MAX_AGENT_CONCURRENCY=2
MAX_REPAIR_ATTEMPTS=2
WORKFLOW_TIMEOUT_MS=1800000
