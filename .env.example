# DNAFix environment. Copy to .env and fill in. Never commit real secrets.

# App
NODE_ENV=development
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
DNAFIX_DATA_DIR=.data

# Network exposure. The API binds loopback unless you opt in explicitly,
# because creating a run executes the target repository's own build scripts.
DNAFIX_BIND_HOST=127.0.0.1
DNAFIX_ALLOW_LAN_BIND=false
# Bearer token for the API. Empty is only allowed on a loopback bind; a
# non-loopback bind without it refuses to start.
DNAFIX_SESSION_TOKEN=
# ;-separated roots the API may open repositories from (use ';' not ':' so
# Windows drive letters survive). Required when binding beyond loopback.
DNAFIX_ALLOWED_REPOSITORY_ROOTS=

# Persistence (local dev uses the JSON file store under DNAFIX_DATA_DIR).
# No PostgreSQL adapter exists yet; this variable is reserved for one.
DATABASE_URL=

# Muse Wonder (Meta Model API) — required for real planning/patching/verification review
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
MUSE_WONDER_MODEL=muse-wonder-1.0
# Sub-agent model (coding + verification). Lead planning stays on Muse Wonder.
MUSE_SPARK_MODEL=muse-spark-1.3
MODEL_TRANSPORT=responses
MUSE_REASONING_EFFORT=

# Project DNA (deterministic repository intelligence). Path to a Project DNA checkout
# with `pnpm install` completed under Node 22.23.2.
PROJECT_DNA_PATH=
PROJECT_DNA_TIMEOUT_MS=600000

# GitHub App — user connection, repository and issue discovery.
# Register the App with docs/GITHUB_APP_SETUP.md, then fill every value below.
# Never commit the private key or client secret. Restart the API after changing them.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Base64-encoded PEM (recommended), e.g. [Convert]::ToBase64String([IO.File]::ReadAllBytes("key.pem"))
GITHUB_APP_PRIVATE_KEY_BASE64=
# Legacy PEM alternative; literal \n sequences are accepted.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
# Public origin where the API is reachable by the browser (used to derive callbacks).
APP_BASE_URL=http://localhost:3001
# Optional explicit overrides. They must match the GitHub App registration exactly.
GITHUB_APP_USER_CALLBACK_URL=
GITHUB_APP_SETUP_URL=
GITHUB_API_VERSION=2022-11-28
# 32-byte key for AES-256-GCM token encryption: base64 or 64-character hex.
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GITHUB_TOKEN_ENCRYPTION_KEY=

# Optional legacy installation used for draft PR delivery when a run has no
# verified per-user installation. User-connected repositories do not need this.
GITHUB_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_BASE_URL=https://api.github.com

# Workflow
WORKFLOW_ENGINE=in-process
TEMPORAL_ADDRESS=
TEMPORAL_TASK_QUEUE=dnafix

# Execution sandbox: docker (default, fails closed when unavailable) | host (dev only, reduced isolation)
SANDBOX_MODE=docker
SANDBOX_IMAGE=node:22-alpine
SANDBOX_MEMORY=1g
SANDBOX_CPUS=1

# Docker Desktop MCP connector (optional; disabled by default, separate from the build sandbox).
# DNAFix only reads Docker MCP profiles and launches `docker mcp gateway run` over stdio.
# Set this only if `docker` is not on PATH or resolves to a .cmd/.bat shim.
DNAFIX_DOCKER_PATH=

# Agent limits
MAX_AGENT_CONCURRENCY=2
MAX_REPAIR_ATTEMPTS=2
WORKFLOW_TIMEOUT_MS=1800000

# Cloud execution (explicit opt-in; never a silent fallback from local)
# local (default) uses SANDBOX_MODE runners. codebuild runs verification on AWS.
DNAFIX_EXECUTION_PROVIDER=local
AWS_REGION=ap-southeast-2
AWS_PROFILE=dnafix-dev
AWS_CODEBUILD_PROJECT=dnafix-build
AWS_ARTIFACT_BUCKET=dnafix-artifacts-121728644078
AWS_CLOUDWATCH_LOG_GROUP=/aws/codebuild/dnafix-build
AWS_ACCOUNT_ID=
# Per-run scoped IAM roles for untrusted builds (default on; disabling requires a recorded decision)
DNAFIX_PER_RUN_ROLES=true
